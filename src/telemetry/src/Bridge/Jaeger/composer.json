{
    "name": "symfony/ai-jaeger-telemetry",
    "description": "Jaeger bridge for Symfony AI Telemetry, exporting the traces to Jaeger",
    "license": "MIT",
    "type": "symfony-ai-telemetry",
    "keywords": [
        "ai",
        "bridge",
        "telemetry",
        "opentelemetry",
        "tracing",
        "jaeger"
    ],
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "open-telemetry/sdk": "^1.3",
        "symfony/ai-telemetry": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Telemetry\\Bridge\\Jaeger\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Telemetry\\Bridge\\Jaeger\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        },
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
