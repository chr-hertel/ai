{
    "name": "symfony/ai-phoenix-feedback-recorder",
    "description": "Arize Phoenix feedback recorder bridge for Symfony AI Feedback, sending feedback as annotations on Phoenix traces",
    "license": "MIT",
    "type": "symfony-ai-feedback-recorder",
    "keywords": [
        "ai",
        "arize",
        "bridge",
        "feedback",
        "phoenix"
    ],
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/ai-feedback": "^1.0",
        "symfony/http-client": "^7.4|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Feedback\\Bridge\\Phoenix\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Feedback\\Bridge\\Phoenix\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
