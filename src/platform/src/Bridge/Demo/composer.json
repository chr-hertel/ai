{
    "name": "symfony/ai-demo-platform",
    "description": "Demo platform bridge for Symfony AI (pipeline scenario)",
    "license": "MIT",
    "type": "symfony-ai-platform",
    "require": {
        "php": ">=8.2",
        "symfony/ai-platform": "^0.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Platform\\Bridge\\Demo\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Platform\\Bridge\\Demo\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
