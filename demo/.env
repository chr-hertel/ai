###> open-telemetry ###
# Traces go to the Langfuse of compose.yaml (http://localhost:3000), any other OTLP/HTTP backend works as well
# Leave the endpoint empty to disable the export
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cGstbGYtc3ltZm9ueS1haS1kZW1vOnNrLWxmLXN5bWZvbnktYWktZGVtbw==,x-langfuse-ingestion-version=4
OTEL_SERVICE_NAME=symfony-ai-demo
# Prompts, completions and tool arguments may contain personal data, only enable this for backends allowed to store it
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
###< open-telemetry ###
