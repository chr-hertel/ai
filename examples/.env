# Credentials for the examples. Copy the lines you need into .env.local and fill them in -
# .env.local is git-ignored, this file is not.
#
# Only secrets live here: API keys, and endpoints or identifiers that are bound to a personal
# account. Everything else is inlined in the examples themselves - the hosts and credentials of
# the services in compose.yaml, the defaults of local daemons like Ollama or LM Studio, and the
# parameters an example picks for itself.

# For using GPT on OpenAI
OPENAI_API_KEY=
# For openai/file-search.php, created in the OpenAI dashboard
OPENAI_VECTOR_STORE_ID=

# For using Claude on Anthropic
ANTHROPIC_API_KEY=

# For using Gemini
GEMINI_API_KEY=

# For using Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_VERTEX_API_KEY=

# For using Mistral
MISTRAL_API_KEY=

# For using Cohere
COHERE_API_KEY=

# For using Voyage
VOYAGE_API_KEY=

# For using Replicate
REPLICATE_API_KEY=

# For using DeepSeek
DEEPSEEK_API_KEY=

# For using Cerebras
CEREBRAS_API_KEY=

# For using Perplexity
PERPLEXITY_API_KEY=

# For using Scaleway
SCALEWAY_SECRET_KEY=

# For using OVH
OVH_AI_SECRET_KEY=

# For using MiniMax
MINI_MAX_API_KEY=

# For using AI/ML API
AIMLAPI_API_KEY=

# For using OpenRouter
OPENROUTER_KEY=

# For using xAI's Grok via the Open Responses bridge
XAI_API_KEY=

# Hugging Face Access Token
HUGGINGFACE_KEY=

# For using Ollama - only needed when the instance requires authentication
OLLAMA_API_KEY=

# For using Albert API (French Sovereign AI)
