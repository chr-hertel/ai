use Symfony\Component\Finder\Finder;

require_once __DIR__.'/vendor/autoload.php';

/**
 * Regenerates INDEX.md, which is the one view the directory tree cannot give you: which capability
 * each platform bridge actually has an example for, side by side, so a gap is visible instead of
 * having to be remembered.
 *
 * @author Christopher Hertel <mail@christopher-hertel.de>
 */
$examples = (new Finder())
    ->files()
    ->in(__DIR__)
    ->name('*.php')
    ->notName(['bootstrap.php', '_*.php'])
    ->exclude(['vendor', 'tests', 'var'])
    ->sortByName();

$platforms = [];
$components = [];

foreach ($examples as $example) {
    $relative = str_replace(\DIRECTORY_SEPARATOR, '/', $example->getRelativePathname());
    [$bucket, $group] = explode('/', $relative, 3) + [1 => ''];
    $name = substr($relative, \strlen($bucket.'/'.$group.'/'), -\strlen('.php'));

    if ('platform' === $bucket) {
        $platforms[$group][$name] = true;
    } else {
        $components[$group][] = $name;
    }
}

ksort($platforms);
ksort($components);

// Capabilities in the order a reader meets them, then whatever else the corpus turned out to have.
$ordered = ['chat', 'stream', 'toolcall', 'toolcall-stream', 'structured-output-math', 'embeddings', 'token-metadata'];
$capabilities = [];
foreach ($platforms as $names) {
    $capabilities = array_merge($capabilities, array_keys($names));
}
$capabilities = array_values(array_unique($capabilities));
usort($capabilities, static function (string $a, string $b) use ($ordered): int {
    $rankA = array_search($a, $ordered, true);
    $rankB = array_search($b, $ordered, true);

    if (false !== $rankA || false !== $rankB) {
        return (false === $rankA ? \PHP_INT_MAX : $rankA) <=> (false === $rankB ? \PHP_INT_MAX : $rankB);
    }

    return strcmp($a, $b);
});

$index = <<<'MARKDOWN'
    # Example Index

    Generated by `./build-index` - do not edit by hand.

    ## Platforms

    Which capability each platform bridge has an example for. An empty cell is a gap, not a
    statement about the provider.

    | Capability | Platforms |
    | --- | --- |

    MARKDOWN;

foreach ($capabilities as $capability) {
    $providers = [];
    foreach ($platforms as $platform => $names) {
        if (isset($names[$capability])) {
            $providers[] = $platform;
        }
    }

    $index .= \sprintf("| `%s` | %s |\n", $capability, implode(', ', $providers));
}

$index .= "\n## Components\n";

foreach ($components as $component => $names) {
    sort($names);
    $index .= \sprintf("\n### %s\n\n", $component);

    foreach ($names as $name) {
        $index .= \sprintf("- `%s`\n", $name);
    }
}

file_put_contents(__DIR__.'/INDEX.md', $index);

echo 'INDEX.md written: '.\count($capabilities).' capabilities across '.\count($platforms)." platforms.\n";
